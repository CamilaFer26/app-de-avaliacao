<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cor principal usada em AppBar, Bot&#195;&#181;es, FAB -->
        <item name="colorPrimary">@color/green_500</item>
        <!-- Cor do texto/&#195;&#173;cone em cima da cor prim&#195;&#161;ria -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- Cor secund&#195;&#161;ria usada em Chips, Sliders, Switches -->
        <item name="colorSecondary">@color/green_300</item>
        <!-- Cor do texto/&#195;&#173;cone sobre a cor secund&#195;&#161;ria -->
        <item name="colorOnSecondary">@color/black</item>

        <!-- Fundo principal das telas -->
        <item name="android:colorBackground">@color/green_100</item>
        <!-- Cor do texto padr&#195;&#163;o em cima do fundo -->
        <item name="android:textColorPrimary">@color/black</item>

        <!-- Cor usada em superf&#195;&#173;cies (Cards, Dialogs, BottomSheet) -->
        <item name="colorSurface">@color/white</item>
        <!-- Texto/&#195;&#173;cones sobre superf&#195;&#173;cies -->
        <item name="colorOnSurface">@color/black</item>

        <!-- Cor usada para destacar erros (TextInputLayout, AlertDialog) -->
        <item name="colorError">@color/red_error</item>
        <!-- Cor do texto sobre &#195;&#161;reas de erro -->
        <item name="colorOnError">@color/white</item>

        <!-- Cor da status bar (barra superior do Android) -->
        <item name="android:statusBarColor">@color/green_500</item>
        <!-- &#195;&#141;cones da status bar ficam escuros (vis&#195;&#173;veis sobre fundo claro) -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- Cor da barra de navega&#195;&#167;&#195;&#163;o (bot&#195;&#181;es virtuais) -->
        <item name="android:navigationBarColor">@color/white</item>

    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />
</resources>