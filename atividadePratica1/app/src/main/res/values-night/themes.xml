<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <!-- Cor principal usada em AppBar, Bot&#195;&#181;es, FAB -->
        <item name="colorPrimary">@color/green_300</item>
        <!-- Texto/&#195;&#173;cones sobre a cor prim&#195;&#161;ria -->
        <item name="colorOnPrimary">@color/black</item>

        <!-- Cor secund&#195;&#161;ria usada em Chips, Sliders, Switches -->
        <item name="colorSecondary">@color/green_200</item>
        <!-- Texto/&#195;&#173;cones sobre a cor secund&#195;&#161;ria -->
        <item name="colorOnSecondary">@color/black</item>

        <!-- Fundo principal das telas -->
        <item name="android:colorBackground">@color/black</item>
        <!-- Cor do texto padr&#195;&#163;o em cima do fundo -->
        <item name="android:textColorPrimary">@color/white</item>

        <!-- Cor usada em superf&#195;&#173;cies (Cards, Dialogs, BottomSheet) -->
        <item name="colorSurface">@color/dark_gray</item>
        <!-- Texto/&#195;&#173;cones sobre superf&#195;&#173;cies -->
        <item name="colorOnSurface">@color/white</item>

        <!-- Cor de erro em inputs/dialogs -->
        <item name="colorError">@color/red_error</item>
        <!-- Texto sobre &#195;&#161;reas de erro -->
        <item name="colorOnError">@color/white</item>

        <!-- Status bar no tema escuro -->
        <item name="android:statusBarColor">@color/black</item>
        <!-- &#195;&#141;cones da status bar ficam claros (brancos) -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Barra de navega&#195;&#167;&#195;&#163;o no tema escuro -->
        <item name="android:navigationBarColor">@color/black</item>
    </style>
</resources>